---
// Horseshoe mark, drawn in the current text color.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <path d="M10.5 5.5C6 13.5 6 25.5 12 31c4.4 4 11.6 4 16 0 6-5.5 6-17.5 1.5-25.5" fill="none" stroke="currentColor" stroke-width="5.2" stroke-linecap="round" />
  <g fill="var(--bg)">
    <circle cx="9.2" cy="15" r="1.15" /><circle cx="10" cy="22.5" r="1.15" />
    <circle cx="30.8" cy="15" r="1.15" /><circle cx="30" cy="22.5" r="1.15" />
    <circle cx="20" cy="32.4" r="1.15" />
  </g>
</svg>
