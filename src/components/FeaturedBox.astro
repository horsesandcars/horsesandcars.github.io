---
import { AUTHORS } from '../config';
import { type Post, postUrl, excerpt, dateToString } from '../lib/posts';
import PostImage from './PostImage.astro';
import StarRating from './StarRating.astro';
import AuthorThumb from './AuthorThumb.astro';
import ReadMoreIcon from './ReadMoreIcon.astro';

interface Props { post: Post }
const { post } = Astro.props;
const author = post.data.author ? AUTHORS[post.data.author] : undefined;
const url = postUrl(post);
---
<!-- begin post -->
<div class="col-md-6 mb-30px">
  <div class="listfeaturedtag h-100">
    <div class="row h-100">
      <div class="col-12 col-md-12 col-lg-5 pr-lg-0">
        <div class="h-100">
          <div class="wrapthumbnail">
            <a href={url}>
              <PostImage name={post.data.image} alt={post.data.title} class="featured-box-img-cover" sizes="(min-width: 992px) 230px, (min-width: 768px) 50vw, 100vw" />
            </a>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-12 col-lg-7">
        <div class="h-100 card-group">
          <div class="card">
            <div class="card-body">
              <h2 class="card-title">
                <a class="text-dark" href={url}>{post.data.title}</a>
                {post.data.rating !== undefined && (
                  <div class="mb-2 mt-2 font-weight-normal"><StarRating rating={post.data.rating} /></div>
                )}
              </h2>
              <h4 class="card-text">{excerpt(post, 25)}</h4>
            </div>
            <div class="card-footer b-0 bg-white mt-auto">
              <div class="wrapfooter">
                {author && (
                  <>
                    <span class="meta-footer-thumb"><AuthorThumb author={author} /></span>
                    <span class="author-meta">
                      <span class="post-name"><a target="_blank" href={author.web}>{author.display_name}</a></span><br />
                    </span>
                  </>
                )}
                <span class="post-date">{dateToString(post.data.date)}</span>
                <span class="post-read-more"><a href={url} title="Read Story"><ReadMoreIcon /></a></span>
                <div class="clearfix"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- end post -->
