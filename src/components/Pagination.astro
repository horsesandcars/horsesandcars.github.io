---
interface Props { current: number; total: number }
const { current, total } = Astro.props;
const pathFor = (n: number) => (n === 1 ? '/#stories' : `/page${n}/#stories`);
---
{total > 1 && (
  <nav class="pagination" aria-label="Pages">
    {current > 1 ? <a href={pathFor(current - 1)} rel="prev">← Newer</a> : <span class="disabled">← Newer</span>}
    {Array.from({ length: total }, (_, i) => i + 1).map((n) =>
      n === current ? <span aria-current="page">{n}</span> : <a href={pathFor(n)}>{n}</a>
    )}
    {current < total ? <a href={pathFor(current + 1)} rel="next">Older →</a> : <span class="disabled">Older →</span>}
  </nav>
)}
