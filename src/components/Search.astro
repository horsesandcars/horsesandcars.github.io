<dialog class="search-dialog" id="search-dialog" aria-label="Search">
  <div class="search-field">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <label for="search-input" class="visually-hidden">Search stories</label>
    <input id="search-input" type="search" placeholder="Search names, places, stories…" autocomplete="off" spellcheck="false" />
    <button type="button" data-search-close>Esc</button>
  </div>
  <ul class="search-results" id="search-results" role="listbox"></ul>
  <p class="search-empty" id="search-empty">Start typing to search every story and page.</p>
</dialog>

<script>
  type Doc = { url: string; title: string; kicker: string; body: string };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const empty = document.getElementById('search-empty') as HTMLParagraphElement;
  let docs: Doc[] | null = null;
  let active = -1;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&${{ '&': 'amp', '<': 'lt', '>': 'gt', '"': 'quot', "'": '#39' }[c]};`);
  const highlight = (text: string, terms: string[]) => {
    let out = esc(text);
    for (const t of terms) out = out.replace(new RegExp(`(${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi'), '<mark>$1</mark>');
    return out;
  };

  async function load() {
    if (!docs) docs = await (await fetch('/search.json')).json();
    return docs!;
  }

  function snippet(body: string, terms: string[]) {
    const lower = body.toLowerCase();
    const hit = Math.min(...terms.map((t) => lower.indexOf(t)).filter((i) => i >= 0), Infinity);
    const start = hit === Infinity ? 0 : Math.max(0, hit - 60);
    return (start > 0 ? '…' : '') + body.slice(start, start + 170).trim() + '…';
  }

  async function run() {
    const q = input.value.trim().toLowerCase();
    const terms = q.split(/\s+/).filter((t) => t.length > 1);
    active = -1;
    if (!terms.length) {
      list.innerHTML = '';
      empty.hidden = false;
      empty.textContent = 'Start typing to search every story and page.';
      return;
    }
    const all = await load();
    const results = all
      .map((d) => {
        const title = d.title.toLowerCase();
        const body = d.body.toLowerCase();
        let score = 0;
        for (const t of terms) {
          if (!title.includes(t) && !body.includes(t)) return null;
          if (title.includes(t)) score += 10;
          score += Math.min(body.split(t).length - 1, 10);
        }
        return { d, score };
      })
      .filter((r): r is { d: Doc; score: number } => r !== null)
      .sort((a, b) => b.score - a.score)
      .slice(0, 12);

    empty.hidden = results.length > 0;
    empty.textContent = `No results for “${input.value.trim()}”.`;
    list.innerHTML = results
      .map(({ d }) => `<li><a href="${d.url}"><span class="kicker">${esc(d.kicker)}</span><br><span class="r-title">${highlight(d.title, terms)}</span><span class="r-snippet">${highlight(snippet(d.body, terms), terms)}</span></a></li>`)
      .join('');
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    load();
  }

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  input.addEventListener('input', run);

  input.addEventListener('keydown', (e) => {
    const links = [...list.querySelectorAll('a')];
    if (!links.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      active = (active + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
      links.forEach((l, i) => l.setAttribute('aria-selected', String(i === active)));
      links[active].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter') {
      e.preventDefault();
      links[Math.max(active, 0)].click();
    }
  });

  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    const typing = t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName);
    if ((e.key === '/' && !typing) || (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey))) {
      e.preventDefault();
      open();
    }
  });
</script>
