---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  kicker?: string;
  frontmatter?: { title: string; description?: string; kicker?: string };
}
// Works both as a component layout and as a Markdown `layout:`
const fm = Astro.props.frontmatter ?? Astro.props;
---
<BaseLayout title={fm.title} description={fm.description}>
  <article class="wrap">
    <header class="article-head">
      {fm.kicker && <span class="kicker">{fm.kicker}</span>}
      <h1>{fm.title}</h1>
      {fm.description && <p class="article-dek">{fm.description}</p>}
    </header>
    <div class="article-body prose">
      <slot />
    </div>
  </article>
</BaseLayout>
