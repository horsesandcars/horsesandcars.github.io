---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found">
  <div class="wrap not-found">
    <div class="big">404</div>
    <h1>This page has wandered off.</h1>
    <p>It may have moved when the site was rebuilt. Try searching, or head back to the stories.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/">Back to home</a>
      <button class="btn btn-ghost" type="button" data-search-open style="cursor:pointer;background:none;font:inherit;font-weight:600">Search the site</button>
    </div>
  </div>
</BaseLayout>
