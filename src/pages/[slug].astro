---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostImage from '../components/PostImage.astro';
import { SITE } from '../config';
import { getPosts, postUrl, categoryUrl, dateLabel, readingTime, type Post } from '../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      older: posts[i + 1] as Post | undefined,
      newer: posts[i - 1] as Post | undefined,
    },
  }));
}) satisfies GetStaticPaths;

const { post, older, newer } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const url = `${SITE.url}${postUrl(post)}`;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const category = data.categories[0];
const shareUrl = encodeURIComponent(url);
const shareTitle = encodeURIComponent(data.title);
---
<BaseLayout title={data.title} description={data.description} image={data.image} ogType="article" publishedTime={data.date}>
  <article class="wrap" itemscope itemtype="https://schema.org/BlogPosting">
    <header class="article-head">
      {category && <span class="kicker"><a href={categoryUrl(category)}>{category}</a></span>}
      <h1 itemprop="headline">{data.title}</h1>
      {data.description && <p class="article-dek" itemprop="description">{data.description}</p>}
      <p class="meta">
        <time datetime={data.date.toISOString()} itemprop="datePublished">{dateLabel(data.date)}</time>
        <span class="dot">{readingTime(post)} min read</span>
        {data.last_modified_at && <span class="dot">Updated {dateLabel(data.last_modified_at)}</span>}
      </p>
    </header>

    {data.image && (
      <figure class="article-hero">
        <PostImage name={data.image} alt={data.title} sizes="(min-width: 1000px) 960px, 100vw" loading="eager" />
      </figure>
    )}

    <div class="article-body">
      {data.toc && tocHeadings.length > 0 && (
        <nav class="toc" aria-label="On this page">
          {data.beforetoc && <p><em>{data.beforetoc}</em></p>}
          <h2>On this page</h2>
          <ul>
            {tocHeadings.map((h) => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ul>
        </nav>
      )}
      <div class="prose" itemprop="articleBody">
        <Content />
      </div>
    </div>

    <footer class="article-foot">
      <ul class="chips" aria-label="Topics">
        {data.categories.map((c) => <li><a class="chip" href={categoryUrl(c)}>{c}</a></li>)}
      </ul>
      <div class="share">
        <span>Share</span>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v1.9H8v3.2h2.6V22H14V11.7h2.6l.4-3.2z"/></svg>
        </a>
        <a href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on X">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"/></svg>
        </a>
        <a href={`mailto:?subject=${shareTitle}&body=${shareUrl}`} aria-label="Share by email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </a>
        <button type="button" data-copy={url} aria-label="Copy link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
        </button>
      </div>
    </footer>
  </article>

  {(older || newer) && (
    <nav class="wrap" aria-label="More stories">
      <div class="post-nav">
        {older && <a class="prev" href={postUrl(older)}><span class="label">← Previous story</span><span class="title">{older.data.title}</span></a>}
        {newer && <a class="next" href={postUrl(newer)}><span class="label">Next story →</span><span class="title">{newer.data.title}</span></a>}
      </div>
    </nav>
  )}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      btn.style.position = 'relative';
      btn.setAttribute('data-copied', '');
      setTimeout(() => btn.removeAttribute('data-copied'), 1500);
    }),
  );
</script>
