---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostImage from '../components/PostImage.astro';
import Share from '../components/Share.astro';
import StarRating from '../components/StarRating.astro';
import AuthorThumb from '../components/AuthorThumb.astro';
import Disqus from '../components/Disqus.astro';
import { SITE, AUTHORS } from '../config';
import { getPosts, postUrl, categoryUrl, dateLong, type Post } from '../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Jekyll semantics: previous = older post, next = newer post
      previous: posts[i + 1] as Post | undefined,
      next: posts[i - 1] as Post | undefined,
    },
  }));
}) satisfies GetStaticPaths;

const { post, previous, next } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const author = data.author ? AUTHORS[data.author] : undefined;
const url = `${SITE.url}${postUrl(post)}`;
const showComments = data.comments && !!SITE.disqus;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const sortedCategories = [...data.categories].sort();
const sortedTags = [...data.tags].sort();
---
<BaseLayout
  title={data.title}
  description={data.description}
  image={data.image}
  keywords={data.keywords}
  author={data.author}
  layout="post"
  isPost
>
  <div class="container">
    <div class="row">
      <div class="col-md-2 pl-0">
        <Share title={data.title} url={url} comments={showComments} />
      </div>

      <div class="col-md-9 flex-first flex-md-unordered">
        <article itemscope itemtype="http://schema.org/BlogPosting">
          <div class="mainheading">
            <header>
              <h1 class="posttitle" itemprop="headline">{data.title}</h1>

              <div style="float:right">
                <small>
                  <span class="post-date" style="text-align:right">Posted: <time class="post-date" datetime={data.date.toISOString()} itemprop="datePublished">{dateLong(data.date)}</time>
                    <br />
                    {data.last_modified_at && (
                      <>(Updated: <time datetime={data.last_modified_at.toISOString()} itemprop="dateModified">{dateLong(data.last_modified_at)}</time>)</>
                    )}
                  </span>
                </small>
              </div>

              {author && (
                <div class="row post-top-meta">
                  <div class="col-xs-12 col-md-9 col-lg-10 text-center text-md-left">
                    <div itemtype="http://schema.org/Person">
                      By: <a class="link-dark" href={author.web} itemprop="sameAs"><span itemprop="name">{author.display_name}</span></a><a href={author.twitter} class="btn follow" itemprop="sameAs">Follow</a>
                    </div>
                  </div>
                </div>
              )}
            </header>
          </div>

          {SITE.adsense.enabled && (
            <>
              <script is:inline async src="//pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
              <ins class="adsbygoogle" style="display:block" data-ad-client={SITE.adsense.client} data-ad-slot={SITE.adsense.slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
              <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
              <br />
            </>
          )}

          <PostImage name={data.image} alt={data.title} class="featured-image img-fluid" sizes="(min-width: 992px) 730px, 100vw" loading="eager" />

          <div class="article-post">
            {data.toc && tocHeadings.length > 0 && (
              <>
                {data.beforetoc && <p><em>{data.beforetoc}</em></p>}
                <div class="toc mt-4 mb-4 lead">
                  <h3 class="font-weight-bold">Summary</h3>
                  <ul>
                    {tocHeadings.map((h) => (
                      <li style={h.depth === 3 ? 'margin-left:1.5em' : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>
                    ))}
                  </ul>
                </div>
              </>
            )}
            <Content />
          </div>

          {data.rating !== undefined && (
            <div class="rating mb-4 d-flex align-items-center">
              <strong class="mr-1">Rating:</strong> <StarRating rating={data.rating} />
            </div>
          )}

          <footer>
            {author && (
              <div class="row post-top-meta">
                <div class="col-xs-12 col-md-12 col-lg-12 text-center text-md-left">
                  <h3>About the Author:</h3>
                  <div class="col-xs-12 col-md-3 col-lg-2 text-center text-md-left mb-4 mb-md-0">
                    <AuthorThumb author={author} />
                  </div>
                  <div class="col-xs-12 col-md-9 col-lg-10 text-center text-md-left" itemprop="author" itemtype="http://schema.org/Person">
                    <a class="link-dark" href={author.web} itemprop="sameAs"><span itemprop="name">{author.display_name}</span></a><a href={author.twitter} class="btn follow" itemprop="sameAs">Follow</a>
                  </div>
                  <span class="author-description" itemprop="description">{author.description}</span>
                </div>
              </div>
            )}
          </footer>

          <div class="after-post-cats">
            <h4><small><a href="/category">Categories:</a></small></h4>
            <ul class="tags mb-4">
              {sortedCategories.map((c) => (
                <li><a class="smoothscroll btn-secondary" href={categoryUrl(c)}>{c}</a></li>
              ))}
            </ul>
          </div>

          <div class="after-post-tags">
            <ul class="tags">
              {sortedTags.map((t) => (
                <li><a class="smoothscroll" href={`/tags#${t.replace(/ /g, '-')}`}>#{t}</a></li>
              ))}
            </ul>
          </div>

          <div class="row PageNavigation d-flex justify-content-between font-weight-bold">
            {previous && <a class="prev d-block col-md-6" href={postUrl(previous)}> &laquo; {previous.data.title}</a>}
            {next && <a class="next d-block col-md-6 text-lg-right" href={postUrl(next)}>{next.data.title} &raquo; </a>}
            <div class="clearfix"></div>
          </div>
        </article>
      </div>
    </div>
  </div>

  {showComments && (
    <div class="container">
      <div id="comments" class="row justify-content-center mb-5">
        <div class="col-md-8"><Disqus /></div>
      </div>
    </div>
  )}

  {data.rating !== undefined && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org/',
      '@type': 'Review',
      itemReviewed: { '@type': 'Thing', name: data.title },
      author: { '@type': 'Person', name: author?.display_name },
      datePublished: data.date.toISOString().slice(0, 10),
      reviewRating: { '@type': 'Rating', ratingValue: String(data.rating), bestRating: '5' },
    })} />
  )}
</BaseLayout>
