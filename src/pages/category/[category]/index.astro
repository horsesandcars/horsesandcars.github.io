---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCategories, slugify, capitalize } from '../../../lib/posts';

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  return categories.map(([name, posts]) => ({
    params: { category: slugify(name) },
    props: { name, posts },
  }));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props;
const label = capitalize(name);
---
<BaseLayout title={label} description={`Stories about ${name} from the Hammond family.`}>
  <div class="wrap">
    <header class="page-head">
      <span class="kicker"><a href="/category">Topics</a></span>
      <h1>{label}</h1>
      <p>{posts.length} {posts.length === 1 ? 'story' : 'stories'} about {name}.</p>
    </header>
    <div class="card-grid section">
      {posts.map((post) => <PostCard post={post} headingLevel="h2" />)}
    </div>
  </div>
</BaseLayout>
